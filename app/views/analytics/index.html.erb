<% content_for :title, "Analytics" %>

<div class="page-head">
  <h1>Analytics</h1>
  <span class="muted">Last 30 days</span>
</div>

<div class="grid">
  <div class="col-12">
    <div class="card">
      <h2>Progress per day</h2>
      <div class="sub">Share of study blocks finished each day</div>
      <%= column_chart @completion_series, max: 100, colors: ["#2bb7a3"], library: { scales: { y: { ticks: { callback: nil } } } } %>
    </div>
  </div>
</div>
