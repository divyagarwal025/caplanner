<% content_for :title, "Analytics" %>

<div class="page-head">
  <h1>Productivity</h1>
  <span class="muted"><%= @from.strftime("%d %b") %> – <%= @to.strftime("%d %b %Y") %></span>
</div>

<div class="card">
  <div class="analytics-top">
    <div>
      <h2>Completion per day</h2>
      <div class="sub">Share of study blocks finished each day</div>
    </div>
    <div class="range-filter">
      <% AnalyticsController::RANGES.each do |key, cfg| %>
        <%= link_to cfg[:label], analytics_path(range: key),
              class: "pill-btn #{@range == key ? 'soft-teal' : 'soft-grey'}" %>
      <% end %>
    </div>
  </div>

  <%= column_chart @completion_series, max: 100, colors: ["#2bb7a3"], height: "420px",
        suffix: "%", library: { scales: { y: { beginAtZero: true, max: 100 } },
                                plugins: { legend: { display: false } } } %>
</div>
