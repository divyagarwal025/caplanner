<% content_for :title, "Calendar" %>
<% prev_m = @month - 1.month; next_m = @month + 1.month %>

<div class="page-head">
  <h1>Calendar</h1>
  <div class="cal-nav">
    <%= link_to "‹ #{prev_m.strftime('%b')}", calendar_path(prev_m.year, prev_m.month) %>
    <strong><%= @month.strftime("%B %Y") %></strong>
    <%= link_to "#{next_m.strftime('%b')} ›", calendar_path(next_m.year, next_m.month) %>
    <%= link_to "Today", calendar_path, class: "muted" %>
  </div>
</div>

<div class="card">
  <table class="cal cal-blocks">
    <thead>
      <tr><% %w[Sun Mon Tue Wed Thu Fri Sat].each { |d| %><th><%= d %></th><% } %></tr>
    </thead>
    <tbody>
      <% @weeks.each do |week| %>
        <tr>
          <% week.each do |day| %>
            <% item     = @items[day]
               in_month = day.month == @month.month
               is_today = day == @today
               is_past  = day < @today %>
            <td>
              <%= link_to day_plan_path(day.iso8601),
                    class: "cell #{'other' unless in_month} #{'today' if is_today} #{'past' if is_past}" do %>
                <div class="cell-head">
                  <span class="dnum"><%= day.day %></span>
                  <% if item && (is_past || is_today) %>
                    <% pc = item.completion_percent %>
                    <span class="pct-badge" style="background:<%= completion_color(pc) %>;<%= 'color:#64748b' if pc.zero? %>"><%= pc %>%</span>
                  <% end %>
                </div>

                <% if item && item.blocks.any? %>
                  <!-- read-only block dots; state cannot be changed from the calendar -->
                  <div class="cell-blocks">
                    <% item.blocks.each do |b| %>
                      <% st = calendar_block_status(b, day) %>
                      <span class="blockdot"
                            style="background:<%= status_dot_color(st) %>"
                            title="<%= [b['subject_code'], b['activity']].compact.join(' · ') %> — <%= status_label(st) %>">
                      </span>
                    <% end %>
                  </div>
                <% end %>
              <% end %>
            </td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>

  <div class="sub" style="margin-top:12px;display:flex;gap:16px;flex-wrap:wrap;align-items:center">
    <span><span class="blockdot" style="background:#14b8a6"></span> Done</span>
    <span><span class="blockdot" style="background:#f59e0b"></span> Partially done</span>
    <span><span class="blockdot" style="background:#cbd5e1"></span> Not started</span>
    <span class="muted">Each dot is one block. Click a day to open and edit it — the calendar is view-only.</span>
  </div>
</div>
