<% content_for :title, "Dashboard — CA Planner" %>

<div class="page-head">
  <h1>Dashboard</h1>
  <span class="muted">
    <%= @date.strftime("%A, %d %B %Y") %>
    <% if @milestone %> · <%= @milestone.name %><% end %>
  </span>
</div>

<!-- ===== hero row: banner + plan CTA ===== -->
<div class="grid">
  <div class="col-8">
    <div class="hero">
      <% quote, author = motivational_quote %>
      <h2 class="hero-quote">❝ <%= quote %></h2>
      <p class="hero-author">— <%= author %></p>
      <div class="hero-stats">
        <div class="hero-pill">
          <span class="ic pink">⏳</span>
          <span><span class="big"><%= @days_left || "—" %></span><br><span class="lbl">Days to exam</span></span>
        </div>
      </div>
    </div>
  </div>

  <div class="col-4">
    <div class="promo">
      <h3>Today at a glance 📊</h3>
      <div class="promo-mini">
        <div class="m">
          <div class="cap blue">This week</div>
          <div class="num"><%= @week_rate %><span style="font-size:.8rem;color:var(--muted)">%</span></div>
        </div>
        <div class="m">
          <div class="cap teal">Blocks today</div>
          <div class="num">
            <%= @today&.blocks_done.to_i %><span style="font-size:.8rem;color:var(--muted)">/<%= @today&.blocks_total.to_i %></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ===== three-column: today's blocks · activity · subjects ===== -->
<div class="grid">
  <!-- today's study blocks -->
  <div class="col-4">
    <div class="card">
      <%= render "today_blocks", today: @today %>
    </div>
  </div>

  <!-- current activity: ring + week strip -->
  <div class="col-4">
    <div class="card">
      <div class="section-title">Current activity</div>
      <%= render "current_activity", today: @today %>

      <div style="margin-top:14px">
        <div class="sub" style="margin-bottom:8px">This week</div>
        <div class="weekstrip">
          <% @week_days.each do |d| %>
            <% item = @week_items[d] %>
            <%= link_to day_plan_path(d.iso8601), class: "d #{'today' if d == @date}" do %>
              <div class="wd"><%= d.strftime("%a") %></div>
              <div class="num"><%= d.day %></div>
              <div class="pip" style="background: <%= completion_color(item&.completion_percent || 0) %>"></div>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- EURA chatbot coach -->
  <div class="col-4">
    <div class="card card-flush">
      <%= render "coach_chat", today: @today %>
    </div>
  </div>
</div>

<!-- ===== roadmap + subjects ===== -->
<div class="grid">
  <div class="col-8">
    <div class="card" style="height:100%">
      <h2>🎯 Roadmap</h2>
      <% if @milestone %>
        <% tasks = @milestone.milestone_subject_tasks.includes(subject: :revision_topics).to_a %>
        <% ms_pct = tasks.any? ? (tasks.sum(&:progress_percent) / tasks.size.to_f).round : 0 %>
        <% days_left = [ (@milestone.end_date - @date).to_i, 0 ].max %>

        <div class="ai-note" style="margin-top:10px">
          <strong><%= @milestone.name %></strong><br>
          <%= @milestone.start_date.strftime("%d %b") %> – <%= @milestone.end_date.strftime("%d %b %Y") %>
          · <span style="font-weight:700"><%= days_left %> days left</span>
        </div>

        <div class="ms-progress-top">
          <span class="sub" style="margin:0">Milestone progress</span>
          <span style="font-weight:800;font-size:.85rem;color:var(--teal)"><%= ms_pct %>%</span>
        </div>
        <div class="bar" style="margin:6px 0 14px"><span style="width:<%= ms_pct %>%"></span></div>

        <div class="sub" style="margin-bottom:10px">What we're covering now</div>
        <div class="ms-tasks">
          <% tasks.sort_by { |t| [t.subject.code, t.task_type] }.each do |t| %>
            <% pct = t.progress_percent %>
            <div class="ms-task">
              <div class="avatar-letter sm" style="background: <%= t.subject.color %>"><%= t.subject.code.first %></div>
              <div class="ms-task-main">
                <div class="ms-task-title">
                  <span><%= t.subject.code %> · <%= t.label %></span>
                  <span class="pill-btn <%= status_pill_class(t.status == "in_progress" ? "partially_done" : (t.status == "done" ? "done" : "not_started")) %>">
                    <%= t.status.humanize %>
                  </span>
                </div>
                <div class="bar" style="margin-top:6px">
                  <span style="width:<%= pct %>%;background:<%= t.subject.color %>"></span>
                </div>
              </div>
              <div class="ms-task-pct"><%= pct %>%</div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="muted" style="margin-top:10px">No active milestone for today.</p>
      <% end %>
      <div class="actions"><%= link_to "See all milestones →", milestones_path %></div>
    </div>
  </div>

  <!-- subjects -->
  <div class="col-4">
    <div class="card" style="height:100%">
      <div class="section-title">Subjects</div>
      <%= render "subjects", subjects: @subjects %>
    </div>
  </div>
</div>
