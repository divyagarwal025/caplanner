<div style="font-family:Georgia,'Times New Roman',serif;max-width:600px;margin:0 auto;color:#1f2937;line-height:1.7;font-size:15px">

  <p style="font-size:1.35rem;font-weight:bold;color:#0f172a;margin:0 0 18px"><%= @letter[:greeting] %></p>

  <p style="margin:0 0 18px"><%= simple_format(@letter[:opening], {}, wrapper_tag: "span") %></p>

  <h2 style="font-size:1.15rem;color:#0f766e;margin:28px 0 14px">🎯 Today's Battle Plan</h2>

  <% @letter[:blocks].each do |b| %>
    <div style="margin:0 0 18px;padding:12px 14px;background:#f8fafc;border-left:4px solid #14b8a6;border-radius:6px">
      <div style="font-weight:bold;color:#0f172a;margin-bottom:4px">
        <%= b[:icon] %> <%= b[:time] %> &nbsp;|&nbsp; <%= b[:title] %>
      </div>
      <div style="color:#475569;font-size:14px"><%= b[:note] %></div>
    </div>
  <% end %>

  <h2 style="font-size:1.1rem;color:#b45309;margin:28px 0 10px">💡 A Little Reminder for You</h2>
  <p style="margin:0 0 18px;color:#374151"><%= @letter[:break_tip] %></p>

  <h2 style="font-size:1.1rem;color:#7c3aed;margin:28px 0 10px">🌟 Today's Motivation</h2>
  <blockquote style="margin:0 0 18px;padding:12px 18px;background:#faf5ff;border-left:4px solid #a855f7;border-radius:6px;font-style:italic;color:#4c1d95">
    &ldquo;<%= @letter[:quote] %>&rdquo;<% if @letter[:quote_author].present? %> <span style="font-style:normal;color:#6b21a8">— <%= @letter[:quote_author] %></span><% end %>
  </blockquote>

  <p style="margin:0 0 24px;color:#374151"><%= simple_format(@letter[:closing], {}, wrapper_tag: "span") %></p>

  <div style="border-top:1px solid #e5e7eb;padding-top:16px;color:#0f172a">
    <p style="margin:0">Your Preparation Guide,</p>
    <p style="margin:4px 0 0;font-weight:bold;font-size:1.1rem"><%= BriefWriter::GUIDE_NAME %> 🤝</p>
    <p style="margin:4px 0 0;color:#64748b;font-style:italic;font-size:13px"><%= @letter[:signoff] %></p>
  </div>
</div>
