<div style="font-family:system-ui,Segoe UI,Roboto,sans-serif;max-width:560px;margin:0 auto;color:#1f2a44">
  <h1 style="font-size:1.3rem">🌙 <%= @date.strftime("%A, %d %B") %> — wrapped up</h1>

  <% if @ai_intro.present? %>
    <p style="background:#f0fdf4;border-left:3px solid #16a34a;padding:10px 14px;border-radius:8px;font-size:14px"><%= @ai_intro %></p>
  <% end %>

  <% if @log %>
    <% pct = @log.completion_percent %>
    <p style="font-size:1.05rem">
      You finished <strong><%= @log.blocks_done %> of <%= @log.blocks_total %></strong>
      blocks today — <strong style="color:<%= pct >= 70 ? '#16a34a' : '#ea580c' %>"><%= pct %>%</strong>.
      Current streak: <strong><%= @streak %></strong> day<%= 's' unless @streak == 1 %>.
    </p>
  <% end %>

  <h2 style="font-size:1rem;border-bottom:2px solid #e2e8f0;padding-bottom:6px;margin-top:22px">
    📅 Tomorrow — <%= (@date + 1).strftime("%A, %d %B") %>
  </h2>

  <% if @tomorrow&.ai_summary.present? %>
    <p style="background:#eef2ff;border-left:3px solid #4f46e5;padding:10px 14px;border-radius:8px;font-size:14px">
      <strong>Plan<%= " (AI-adjusted)" if @tomorrow.ai_generated %>:</strong> <%= @tomorrow.ai_summary %>
    </p>
  <% end %>

  <table style="width:100%;border-collapse:collapse;font-size:14px">
    <% @tasks.each do |t| %>
      <% next if t.kind == "health" %>
      <tr>
        <td style="padding:8px 6px;color:#64748b;white-space:nowrap">
          <%= [ t.start_time, t.end_time ].compact.join("–").presence || "—" %>
        </td>
        <td style="padding:8px 6px"><%= t.activity %></td>
        <td style="padding:8px 6px;text-align:right">
          <span style="background:#eef2ff;color:#3730a3;padding:2px 8px;border-radius:999px;font-size:11px"><%= t.kind %></span>
        </td>
      </tr>
    <% end %>
  </table>

  <% if @backlog.to_i.positive? %>
    <p style="background:#fff7ed;border-left:3px solid #ea580c;padding:10px 14px;border-radius:8px;font-size:14px;color:#1f2a44">
      📌 <strong><%= @backlog %> skipped <%= @backlog == 1 ? 'slot' : 'slots' %></strong> in your backlog —
      these are scheduled as <strong>weekend catch-up</strong> blocks so you still finish by the exam.
    </p>
  <% end %>

  <h2 style="font-size:1rem;border-bottom:2px solid #e2e8f0;padding-bottom:6px;margin-top:22px">🧭 Your guide</h2>
  <% if @guide %>
    <p style="font-weight:700;font-size:14px;margin:8px 0 4px"><%= @guide.headline %></p>
    <p style="font-size:14px;color:#3d4a66;margin:0 0 10px"><%= @guide.narrative %></p>
    <p style="font-size:13px;color:#64748b;margin:0 0 4px"><strong>Do next:</strong></p>
    <ul style="font-size:14px;padding-left:18px;margin:0">
      <% @guide.guidance.each do |step| %><li><%= step %></li><% end %>
    </ul>
  <% end %>
  <% if @journey %>
    <p style="font-size:13px;color:#64748b;margin-top:12px">
      On current pace you finish <strong><%= @journey.phases.last.end_date.strftime("%d %b %Y") %></strong>
      — <%= @journey.buffer_days >= 0 ? "#{@journey.buffer_days} days buffer" : "#{-@journey.buffer_days} days over" %>.
    </p>
  <% end %>

  <p style="color:#64748b;font-size:13px;margin-top:22px">
    Anything you didn't finish today has been carried into tomorrow's plan. One block at a time. 💪
  </p>
</div>
