<%= form_with model: log, url: url, method: method do |f| %>
  <div class="checks">
    <label><%= f.check_box :walked %> Walked 20–30 min</label>
    <label><%= f.check_box :water_ok %> 2–2.5 L water</label>
    <label><%= f.check_box :sleep_ok %> 7+ h sleep</label>
  </div>
  <div class="field">
    <label>Mood (1–5)</label>
    <%= f.number_field :mood, in: 1..5, step: 1 %>
  </div>
  <div class="field">
    <label>Notes</label>
    <%= f.text_area :notes, rows: 2, placeholder: "What went well / what to fix tomorrow" %>
  </div>
  <%= f.submit "Save tonight's log", class: "btn" %>
<% end %>
