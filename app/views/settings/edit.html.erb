<% content_for :title, "Settings" %>
<h1 style="font-size:1.3rem">Settings</h1>

<div class="card">
  <%= form_with model: @setting, url: settings_path, method: :patch do |f| %>
    <div class="field">
      <label>Exam date (CA Final attempt)</label>
      <%= f.date_field :exam_date, value: @setting.exam_on %>
    </div>
    <div class="field">
      <label>Email (where briefs are sent)</label>
      <%= f.email_field :email %>
    </div>
    <div class="field">
      <label>Morning brief hour (0–23, <%= @setting.timezone %>)</label>
      <%= f.number_field :morning_hour, in: 0..23 %>
    </div>
    <div class="field">
      <label>Evening review hour (0–23)</label>
      <%= f.number_field :evening_hour, in: 0..23 %>
    </div>
    <div class="field">
      <label>Timezone</label>
      <%= f.text_field :timezone %>
    </div>
    <%= f.submit "Save settings", class: "btn" %>
  <% end %>
</div>
